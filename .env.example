# Reference this from the Railway Postgres service on the web service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# The Postgres service name in ${{...}} must match the service name in Railway.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/der_zirkel

# Long random string used to sign login cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# This account becomes an administrator when it registers.
INITIAL_ADMIN_EMAIL=zbigniew.lobocki@gmail.com
